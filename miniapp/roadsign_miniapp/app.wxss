/* ===== 全局样式 ===== */
page {
  --bg: #fdf6e3;
  --bg-card: #ffffff;
  --bg-alt: #fef9ef;
  --text: #2d1b0e;
  --text2: #5c4033;
  --text3: #8b7355;
  --accent: #c0392b;
  --accent2: #d4a017;
  --accent3: #1a6b4b;
  --border: #e8d5b0;
  --shadow: 0 4px 24px rgba(139, 69, 19, 0.08);
  --gold: #b8860b;
  --gold-light: #faf0d7;
  --red-light: #fde8e8;
  --green-light: #e8f5e9;
  --nav-bg: linear-gradient(135deg, #8b0000 0%, #c0392b 30%, #7b2d1e 60%, #4a1a0a 100%);

  background-color: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 深色模式 */
page.dark {
  --bg: #1a0f0a;
  --bg-card: #261a12;
  --bg-alt: #2d1f15;
  --text: #f0e6d3;
  --text2: #c4ad8b;
  --text3: #8b7355;
  --accent: #e74c3c;
  --accent2: #f0c040;
  --accent3: #2ecc71;
  --border: #3d2a1a;
  --shadow: 0 4px 24px rgba(0,0,0,0.4);
  --gold: #f0c040;
  --gold-light: #2d1a10;
  --red-light: #3d1a1a;
  --green-light: #1a3d1e;
}

/* 大字体模式 */
page.large {
  font-size: 34rpx;
}

/* 高对比度模式 */
page.contrast {
  filter: contrast(1.25) brightness(1.1);
}

/* ===== 通用组件 ===== */
.card {
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  border-radius: 16rpx;
  box-shadow: var(--shadow);
  margin: 20rpx;
  overflow: hidden;
}

.card-header {
  padding: 24rpx 30rpx;
  border-bottom: 2rpx solid var(--border);
  font-weight: 700;
  font-size: 30rpx;
  background: var(--bg-alt);
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.card-body {
  padding: 30rpx;
}

/* ===== 按钮 ===== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 18rpx 36rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  transition: all 0.2s;
}

.btn-primary {
  background: var(--accent);
  color: #fff;
}

.btn-primary:active {
  opacity: 0.8;
  transform: scale(0.97);
}

.btn-outline {
  background: transparent;
  color: var(--accent);
  border: 2rpx solid var(--accent);
}

.btn-gold {
  background: var(--accent2);
  color: #fff;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

/* ===== 指示器 ===== */
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  display: inline-block;
}

.dot-green { background: #27ae60; }
.dot-yellow { background: #f39c12; }
.dot-red { background: #e74c3c; }

/* ===== 标签 ===== */
.tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.tag-guide { background: #d4edda; color: #155724; }
.tag-place { background: #d1ecf1; color: #0c5460; }
.tag-warn  { background: #fff3cd; color: #856404; }
.tag-road  { background: #e2d9f3; color: #5a3d8a; }
.tag-district { background: #f8d7da; color: #721c24; }

/* ===== Toast ===== */
.toast {
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #2d1b0e;
  color: #f0e6d3;
  padding: 16rpx 40rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  z-index: 999;
  opacity: 0;
  transition: opacity 0.3s;
  pointer-events: none;
}
.toast.show { opacity: 1; }
